+
+struct ksu_legacy_serialized_policy {
+    void *data;
+    size_t len;
+    size_t generation;
+    int android_netlink_route;
+    int android_netlink_getneigh;
+};
+
+/* policydb->len is the loaded input length, not necessarily the output size. */
+static int ksu_legacy_serialize_policy(struct policydb *db, rwlock_t *lock,
+                                       size_t min_len,
+                                       struct ksu_legacy_serialized_policy *serialized)
+{
+    struct policy_file fp;
+    unsigned long flags;
+    size_t alloc_len;
+    void *data;
+    int ret;
+
+    memset(serialized, 0, sizeof(*serialized));
+
+    if (lock) {
+        read_lock_irqsave(lock, flags);
+        if (db->len > min_len)
+            min_len = db->len;
+        read_unlock_irqrestore(lock, flags);
+    } else if (db->len > min_len) {
+        min_len = db->len;
+    }
+
+    alloc_len = max_t(size_t, min_len, PAGE_SIZE);
+    for (;;) {
+        data = vmalloc(alloc_len);
+        if (!data)
+            return -ENOMEM;
+
+        if (lock)
+            read_lock_irqsave(lock, flags);
+
+        fp.data = data;
+        fp.len = alloc_len;
+        ret = policydb_write(db, &fp);
+        if (!ret) {
+            serialized->data = data;
+            serialized->len = alloc_len - fp.len;
+            if (lock)
+                serialized->generation = ksu_legacy_policy_generation(db);
+            else
+                serialized->generation = db->len;
+            serialized->android_netlink_route = db->android_netlink_route;
+            serialized->android_netlink_getneigh = db->android_netlink_getneigh;
+        }
+
+        if (lock)
+            read_unlock_irqrestore(lock, flags);
+
+        if (!ret)
+            return 0;
+
+        vfree(data);
+        if (ret != -EINVAL || fp.len == alloc_len)
+            return ret;
+        if (alloc_len > SIZE_MAX / 2)
+            return -E2BIG;
+        alloc_len *= 2;
+    }
+}
+
+static int ksu_legacy_take_policy_snapshot(struct ksu_legacy_policy_snapshot *snapshot)
+{
+    struct policydb *db = get_policydb();
+    rwlock_t *lock = ksu_get_policy_rwlock();
+    struct ksu_legacy_serialized_policy serialized;
+    int ret;
+
+    if (!lock) {
+        pr_err("%s: policy lock is unavailable\n", __func__);
+        return -ENOTSUPP;
+    }
+
+    ret = ksu_legacy_serialize_policy(db, lock, 0, &serialized);
+    if (ret)
+        return ret;
+
+    snapshot->data = serialized.data;
+    snapshot->data_len = serialized.len;
+    snapshot->policy_len = serialized.len;
+    snapshot->generation = serialized.generation;
+    snapshot->android_netlink_route = serialized.android_netlink_route;
+    snapshot->android_netlink_getneigh = serialized.android_netlink_getneigh;
+    return 0;
+}
+
+static void ksu_legacy_drop_policy(struct policydb *db)
+{
+    if (!db)
+        return;
+    policydb_destroy(db);
+    kfree(db);
+}
+
+static int ksu_legacy_clone_policy(const struct ksu_legacy_policy_snapshot *snapshot,
+                                   struct policydb **out)
+{
+    struct policydb *db;
+    struct policy_file fp;
+    int ret;
+
+    db = kzalloc(sizeof(*db), GFP_KERNEL);
+    if (!db)
+        return -ENOMEM;
+
+    fp.data = snapshot->data;
+    fp.len = snapshot->data_len;
+    ret = policydb_read(db, &fp);
+    if (ret) {
+        /* policydb_read() destroys its partially initialized database. */
+        kfree(db);
+        return ret;
+    }
+
+    db->len = snapshot->policy_len;
+    db->android_netlink_route = snapshot->android_netlink_route;
+    db->android_netlink_getneigh = snapshot->android_netlink_getneigh;
+    *out = db;
+    return 0;
+}
+
+static int ksu_legacy_refresh_policy_len(struct policydb *db)
 {
-    return &current->cpus_allowed;
+    struct ksu_legacy_serialized_policy serialized;
+    int ret;
+
+    ret = ksu_legacy_serialize_policy(db, NULL, db->len, &serialized);
+    if (ret)
+        return ret;
+
+    db->len = serialized.len;
+    vfree(serialized.data);
+    return 0;
 }
+
+static int ksu_legacy_install_policy(struct policydb *new_db,
+                                     const struct ksu_legacy_policy_snapshot *snapshot)
+{
+    struct policydb *old_db = get_policydb();
+    rwlock_t *lock = ksu_get_policy_rwlock();
+    struct policydb old_copy;
+    unsigned long flags;
+
+    if (!lock)
+        return -ENOTSUPP;
+
+    ksu_boottrace("policy_lock_before");
+    write_lock_irqsave(lock, flags);
+    ksu_boottrace("policy_lock_acquired");
+    if (ksu_legacy_policy_generation(old_db) != snapshot->generation) {
+        ksu_boottrace("policy_lock_conflict");
+        write_unlock_irqrestore(lock, flags);
+        ksu_boottrace("policy_unlock_done");
+        return -EAGAIN;
+    }
+
+    memcpy(&old_copy, old_db, sizeof(old_copy));
+    memcpy(old_db, new_db, sizeof(*old_db));
+#if defined(KSU_COMPAT_USE_SELINUX_STATE)
+    selinux_state.ss->latest_granting++;
+    selinux_state.android_netlink_route = old_db->android_netlink_route;
+    selinux_state.android_netlink_getneigh = old_db->android_netlink_getneigh;
 #endif
+    memset(new_db, 0, sizeof(*new_db));
+    write_unlock_irqrestore(lock, flags);
+    ksu_boottrace("policy_unlock_done");

-#endif // < 5.10
+    policydb_destroy(&old_copy);
+    return 0;
+}
+
+#endif
