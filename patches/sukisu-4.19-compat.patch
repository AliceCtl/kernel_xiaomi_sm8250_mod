diff --git a/kernel/hook/lsm_hook.c b/kernel/hook/lsm_hook.c
index 0070283..43ab80d 100644
--- a/kernel/hook/lsm_hook.c
+++ b/kernel/hook/lsm_hook.c
@@ -81,2 +81,27 @@ do_umount:
 }
+
+/*
+ * Some Android 15 vendor zygotes transition the child to its app SELinux
+ * domain before setresuid().  In that case the SUSFS syscall hook above
+ * deliberately ignores the process, so recover manager injection from the
+ * credential transition while the old credential is still root.
+ */
+static int ksu_task_fix_setuid(struct cred *new, const struct cred *old, int flags)
+{
+    uid_t new_uid;
+
+    if (unlikely(!new || !old) || old->uid.val != 0)
+        return 0;
+
+    new_uid = new->uid.val;
+    if (likely(ksu_is_manager_appid_valid()) &&
+        unlikely(is_uid_manager(new_uid)) &&
+        !susfs_is_sid_equal(old, susfs_zygote_sid)) {
+        disable_seccomp();
+        pr_info("install fd for manager fallback: %d\n", new_uid);
+        ksu_install_fd();
+    }
+
+    return 0;
+}
 #else
@@ -115,5 +140,3 @@ static struct security_hook_list ksu_hooks[] = {
 #endif
-#ifndef CONFIG_KSU_SUSFS
     LSM_HOOK_INIT(task_fix_setuid, ksu_task_fix_setuid),
-#endif
 };
